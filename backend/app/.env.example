# Application Settings
APP_NAME="Maritime Freight Intelligence & Forecasting API"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL 15 with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/maritime_freight"

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID="maritime-freight-sih"
# Path to service account JSON file (optional if using Google Application Default Credentials)
FIREBASE_SERVICE_ACCOUNT_PATH=""

# CORS Allowed Origins (JSON array or comma-separated URLs)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
